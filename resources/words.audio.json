[
  {
    "filename": "aa3baa4-dad",
    "id": "aa3baa4-dad",
    "text": "阿爸"
  },
  {
    "filename": "aa3baa4-dad-example-1",
    "id": "aa3baa4-dad-example-1",
    "text": "阿爸今日返工呀？"
  },
  {
    "filename": "aa3baa4-dad-example-2",
    "id": "aa3baa4-dad-example-2",
    "text": "我阿爸好鍾意打波。"
  },
  {
    "filename": "aa3baa4-dad-example-3",
    "id": "aa3baa4-dad-example-3",
    "text": "聽阿爸講故事俾我聽。"
  },
  {
    "filename": "aa3baa4-dad-example-4",
    "id": "aa3baa4-dad-example-4",
    "text": "阿爸帶我去公園玩。"
  },
  {
    "filename": "aa3maa1-mum",
    "id": "aa3maa1-mum",
    "text": "阿媽"
  },
  {
    "filename": "aa3maa1-mum-example-1",
    "id": "aa3maa1-mum-example-1",
    "text": "阿媽今日唔舒服。"
  },
  {
    "filename": "aa3maa1-mum-example-2",
    "id": "aa3maa1-mum-example-2",
    "text": "我啱啱見咗阿媽。"
  },
  {
    "filename": "aa3maa1-mum-example-3",
    "id": "aa3maa1-mum-example-3",
    "text": "阿媽煮咗晚飯喇。"
  },
  {
    "filename": "aa3maa1-mum-example-4",
    "id": "aa3maa1-mum-example-4",
    "text": "我想打電話畀阿媽。"
  },
  {
    "filename": "baa4baa1-father",
    "id": "baa4baa1-father",
    "text": "爸爸"
  },
  {
    "filename": "baa4baa1-father-example-1",
    "id": "baa4baa1-father-example-1",
    "text": "我今日同爸爸去公園。"
  },
  {
    "filename": "baa4baa1-father-example-2",
    "id": "baa4baa1-father-example-2",
    "text": "爸爸，你食咗飯未呀？"
  },
  {
    "filename": "baa4baa1-father-example-3",
    "id": "baa4baa1-father-example-3",
    "text": "爸爸幫我做功課。"
  },
  {
    "filename": "baa4baa1-father-example-4",
    "id": "baa4baa1-father-example-4",
    "text": "你嘅爸爸喺邊度？"
  },
  {
    "filename": "baak3baak3-uncle-fathers-older",
    "id": "baak3baak3-uncle-fathers-older",
    "text": "伯伯"
  },
  {
    "filename": "baak3baak3-uncle-fathers-older-example-1",
    "id": "baak3baak3-uncle-fathers-older-example-1",
    "text": "我嘅伯伯今日嚟探我。"
  },
  {
    "filename": "baak3baak3-uncle-fathers-older-example-2",
    "id": "baak3baak3-uncle-fathers-older-example-2",
    "text": "伯伯幫我買咗禮物。"
  },
  {
    "filename": "baak3baak3-uncle-fathers-older-example-3",
    "id": "baak3baak3-uncle-fathers-older-example-3",
    "text": "你知唔知你嘅伯伯喺邊？"
  },
  {
    "filename": "baak3baak3-uncle-fathers-older-example-4",
    "id": "baak3baak3-uncle-fathers-older-example-4",
    "text": "伯伯經常教我點解功課。"
  },
  {
    "filename": "baak3mou5-aunt-paternal",
    "id": "baak3mou5-aunt-paternal",
    "text": "伯母"
  },
  {
    "filename": "baak3mou5-aunt-paternal-example-1",
    "id": "baak3mou5-aunt-paternal-example-1",
    "text": "我伯母煮咗好多好味嘅餸。"
  },
  {
    "filename": "baak3mou5-aunt-paternal-example-2",
    "id": "baak3mou5-aunt-paternal-example-2",
    "text": "你認識我伯母嗎？"
  },
  {
    "filename": "baak3mou5-aunt-paternal-example-3",
    "id": "baak3mou5-aunt-paternal-example-3",
    "text": "伯母今次嚟我哋屋企玩。"
  },
  {
    "filename": "baak3mou5-aunt-paternal-example-4",
    "id": "baak3mou5-aunt-paternal-example-4",
    "text": "我伯母好鍾意種花。"
  },
  {
    "filename": "biu1dai6-cousin-younger-male-maternal",
    "id": "biu1dai6-cousin-younger-male-maternal",
    "text": "表弟"
  },
  {
    "filename": "biu1dai6-cousin-younger-male-maternal-example-1",
    "id": "biu1dai6-cousin-younger-male-maternal-example-1",
    "text": "我同表弟去打籃球。"
  },
  {
    "filename": "biu1dai6-cousin-younger-male-maternal-example-2",
    "id": "biu1dai6-cousin-younger-male-maternal-example-2",
    "text": "表弟今次考試考得唔錯。"
  },
  {
    "filename": "biu1dai6-cousin-younger-male-maternal-example-3",
    "id": "biu1dai6-cousin-younger-male-maternal-example-3",
    "text": "聽講你表弟住喺尖沙咀？"
  },
  {
    "filename": "biu1dai6-cousin-younger-male-maternal-example-4",
    "id": "biu1dai6-cousin-younger-male-maternal-example-4",
    "text": "下次我帶表弟去行街。"
  },
  {
    "filename": "biu1go1-cousin-older-male-maternal",
    "id": "biu1go1-cousin-older-male-maternal",
    "text": "表哥"
  },
  {
    "filename": "biu1go1-cousin-older-male-maternal-example-1",
    "id": "biu1go1-cousin-older-male-maternal-example-1",
    "text": "我嘅表哥叫阿文。"
  },
  {
    "filename": "biu1go1-cousin-older-male-maternal-example-2",
    "id": "biu1go1-cousin-older-male-maternal-example-2",
    "text": "今晚同表哥一齊食飯。"
  },
  {
    "filename": "biu1go1-cousin-older-male-maternal-example-3",
    "id": "biu1go1-cousin-older-male-maternal-example-3",
    "text": "表哥幫我做功課。"
  },
  {
    "filename": "biu1go1-cousin-older-male-maternal-example-4",
    "id": "biu1go1-cousin-older-male-maternal-example-4",
    "text": "表哥成日帶我去打波。"
  },
  {
    "filename": "biu1mui6-cousin-younger-female-maternal",
    "id": "biu1mui6-cousin-younger-female-maternal",
    "text": "表妹"
  },
  {
    "filename": "biu1mui6-cousin-younger-female-maternal-example-1",
    "id": "biu1mui6-cousin-younger-female-maternal-example-1",
    "text": "我個表妹好叻，成日攞獎。"
  },
  {
    "filename": "biu1mui6-cousin-younger-female-maternal-example-2",
    "id": "biu1mui6-cousin-younger-female-maternal-example-2",
    "text": "星期六我同表妹一齊去買嘢。"
  },
  {
    "filename": "biu1mui6-cousin-younger-female-maternal-example-3",
    "id": "biu1mui6-cousin-younger-female-maternal-example-3",
    "text": "你有冇表妹？"
  },
  {
    "filename": "biu1mui6-cousin-younger-female-maternal-example-4",
    "id": "biu1mui6-cousin-younger-female-maternal-example-4",
    "text": "我成日同表妹玩牌。"
  },
  {
    "filename": "biu1ze2-cousin-older-female-maternal",
    "id": "biu1ze2-cousin-older-female-maternal",
    "text": "表姐"
  },
  {
    "filename": "biu1ze2-cousin-older-female-maternal-example-1",
    "id": "biu1ze2-cousin-older-female-maternal-example-1",
    "text": "我嘅表姐今日嚟我屋企玩。"
  },
  {
    "filename": "biu1ze2-cousin-older-female-maternal-example-2",
    "id": "biu1ze2-cousin-older-female-maternal-example-2",
    "text": "表姐同我講咗好多家庭故事。"
  },
  {
    "filename": "biu1ze2-cousin-older-female-maternal-example-3",
    "id": "biu1ze2-cousin-older-female-maternal-example-3",
    "text": "我成日同表姐一齊去街市。"
  },
  {
    "filename": "biu1ze2-cousin-older-female-maternal-example-4",
    "id": "biu1ze2-cousin-older-female-maternal-example-4",
    "text": "表姐好叻，佢係學生會主席。"
  },
  {
    "filename": "can1cik1-relatives",
    "id": "can1cik1-relatives",
    "text": "親戚"
  },
  {
    "filename": "can1cik1-relatives-example-1",
    "id": "can1cik1-relatives-example-1",
    "text": "我今次去探親戚。"
  },
  {
    "filename": "can1cik1-relatives-example-2",
    "id": "can1cik1-relatives-example-2",
    "text": "你有冇好多親戚住喺呢度？"
  },
  {
    "filename": "can1cik1-relatives-example-3",
    "id": "can1cik1-relatives-example-3",
    "text": "親戚嚟我屋企食飯。"
  },
  {
    "filename": "can1cik1-relatives-example-4",
    "id": "can1cik1-relatives-example-4",
    "text": "佢哋嘅親戚好關心佢。"
  },
  {
    "filename": "daai6go1-older-brother",
    "id": "daai6go1-older-brother",
    "text": "大哥"
  },
  {
    "filename": "daai6go1-older-brother-example-1",
    "id": "daai6go1-older-brother-example-1",
    "text": "我嘅大哥教我玩籃球。"
  },
  {
    "filename": "daai6go1-older-brother-example-2",
    "id": "daai6go1-older-brother-example-2",
    "text": "大哥，你今日好忙嗎？"
  },
  {
    "filename": "daai6go1-older-brother-example-3",
    "id": "daai6go1-older-brother-example-3",
    "text": "阿明係我嘅大哥。"
  },
  {
    "filename": "daai6go1-older-brother-example-4",
    "id": "daai6go1-older-brother-example-4",
    "text": "你搵大哥幫手啦！"
  },
  {
    "filename": "daai6ze2-older-sister",
    "id": "daai6ze2-older-sister",
    "text": "大姐"
  },
  {
    "filename": "daai6ze2-older-sister-example-1",
    "id": "daai6ze2-older-sister-example-1",
    "text": "我嘅大姐好照顧我。"
  },
  {
    "filename": "daai6ze2-older-sister-example-2",
    "id": "daai6ze2-older-sister-example-2",
    "text": "大姐今日唔返屋企。"
  },
  {
    "filename": "daai6ze2-older-sister-example-3",
    "id": "daai6ze2-older-sister-example-3",
    "text": "我大姐教我點煮飯。"
  },
  {
    "filename": "daai6ze2-older-sister-example-4",
    "id": "daai6ze2-older-sister-example-4",
    "text": "聽日約我同大姐食飯啦。"
  },
  {
    "filename": "dai6dai6-younger-brother",
    "id": "dai6dai6-younger-brother",
    "text": "弟弟"
  },
  {
    "filename": "dai6dai6-younger-brother-example-1",
    "id": "dai6dai6-younger-brother-example-1",
    "text": "我有一個弟弟。"
  },
  {
    "filename": "dai6dai6-younger-brother-example-2",
    "id": "dai6dai6-younger-brother-example-2",
    "text": "弟弟今日唔返學。"
  },
  {
    "filename": "dai6dai6-younger-brother-example-3",
    "id": "dai6dai6-younger-brother-example-3",
    "text": "你嘅弟弟幾歲？"
  },
  {
    "filename": "dai6dai6-younger-brother-example-4",
    "id": "dai6dai6-younger-brother-example-4",
    "text": "弟弟鍾意打籃球。"
  },
  {
    "filename": "fu6can1-father-formal",
    "id": "fu6can1-father-formal",
    "text": "父親"
  },
  {
    "filename": "fu6can1-father-formal-example-1",
    "id": "fu6can1-father-formal-example-1",
    "text": "我嘅父親今日返工好忙。"
  },
  {
    "filename": "fu6can1-father-formal-example-2",
    "id": "fu6can1-father-formal-example-2",
    "text": "你嘅父親仲喺屋企嗎？"
  },
  {
    "filename": "fu6can1-father-formal-example-3",
    "id": "fu6can1-father-formal-example-3",
    "text": "我想同父親傾下計。"
  },
  {
    "filename": "fu6can1-father-formal-example-4",
    "id": "fu6can1-father-formal-example-4",
    "text": "父親節我買咗花俾佢。"
  },
  {
    "filename": "gaa1gung1-father-in-law-husband-side",
    "id": "gaa1gung1-father-in-law-husband-side",
    "text": "家公"
  },
  {
    "filename": "gaa1gung1-father-in-law-husband-side-example-1",
    "id": "gaa1gung1-father-in-law-husband-side-example-1",
    "text": "我今日帶咗禮物去見我嘅家公。"
  },
  {
    "filename": "gaa1gung1-father-in-law-husband-side-example-2",
    "id": "gaa1gung1-father-in-law-husband-side-example-2",
    "text": "家公教我整咗碟好味嘅菜。"
  },
  {
    "filename": "gaa1gung1-father-in-law-husband-side-example-3",
    "id": "gaa1gung1-father-in-law-husband-side-example-3",
    "text": "我哋今晚去屋企睇吓家公。"
  },
  {
    "filename": "gaa1gung1-father-in-law-husband-side-example-4",
    "id": "gaa1gung1-father-in-law-husband-side-example-4",
    "text": "家公好鐘意花，多謝你送咗花畀佢。"
  },
  {
    "filename": "gaa1hau6-household",
    "id": "gaa1hau6-household",
    "text": "家口"
  },
  {
    "filename": "gaa1hau6-household-example-1",
    "id": "gaa1hau6-household-example-1",
    "text": "我哋家口有五個人。"
  },
  {
    "filename": "gaa1hau6-household-example-2",
    "id": "gaa1hau6-household-example-2",
    "text": "你嘅家口都健康嗎？"
  },
  {
    "filename": "gaa1hau6-household-example-3",
    "id": "gaa1hau6-household-example-3",
    "text": "我家口好忙，朝早起身做嘢。"
  },
  {
    "filename": "gaa1hau6-household-example-4",
    "id": "gaa1hau6-household-example-4",
    "text": "報告要寫埋家口嘅資料。"
  },
  {
    "filename": "gaa1jan4-family-members",
    "id": "gaa1jan4-family-members",
    "text": "家人"
  },
  {
    "filename": "gaa1jan4-family-members-example-1",
    "id": "gaa1jan4-family-members-example-1",
    "text": "我今晚同家人一齊食飯。"
  },
  {
    "filename": "gaa1jan4-family-members-example-2",
    "id": "gaa1jan4-family-members-example-2",
    "text": "你嘅家人住喺邊度？"
  },
  {
    "filename": "gaa1jan4-family-members-example-3",
    "id": "gaa1jan4-family-members-example-3",
    "text": "家人最緊要，唔好忽略佢哋。"
  },
  {
    "filename": "gaa1jan4-family-members-example-4",
    "id": "gaa1jan4-family-members-example-4",
    "text": "放假我會陪家人去旅行。"
  },
  {
    "filename": "gaa1po4-mother-in-law-husband-side",
    "id": "gaa1po4-mother-in-law-husband-side",
    "text": "家婆"
  },
  {
    "filename": "gaa1po4-mother-in-law-husband-side-example-1",
    "id": "gaa1po4-mother-in-law-husband-side-example-1",
    "text": "我屋企嘅家婆好好人。"
  },
  {
    "filename": "gaa1po4-mother-in-law-husband-side-example-2",
    "id": "gaa1po4-mother-in-law-husband-side-example-2",
    "text": "今晚我哋去拜訪我嘅家婆。"
  },
  {
    "filename": "gaa1po4-mother-in-law-husband-side-example-3",
    "id": "gaa1po4-mother-in-law-husband-side-example-3",
    "text": "家婆煮飯煮得好好味。"
  },
  {
    "filename": "gaa1po4-mother-in-law-husband-side-example-4",
    "id": "gaa1po4-mother-in-law-husband-side-example-4",
    "text": "我嘅家婆經常幫手照顧細路。"
  },
  {
    "filename": "gaa1ting4-family-household",
    "id": "gaa1ting4-family-household",
    "text": "家庭"
  },
  {
    "filename": "gaa1ting4-family-household-example-1",
    "id": "gaa1ting4-family-household-example-1",
    "text": "我哋家庭好團結。"
  },
  {
    "filename": "gaa1ting4-family-household-example-2",
    "id": "gaa1ting4-family-household-example-2",
    "text": "呢個家庭有五個人。"
  },
  {
    "filename": "gaa1ting4-family-household-example-3",
    "id": "gaa1ting4-family-household-example-3",
    "text": "家庭生活唔容易，但好重要。"
  },
  {
    "filename": "gaa1ting4-family-household-example-4",
    "id": "gaa1ting4-family-household-example-4",
    "text": "佢哋嘅家庭好幸福。"
  },
  {
    "filename": "gaa1zoeng2-parent",
    "id": "gaa1zoeng2-parent",
    "text": "家長"
  },
  {
    "filename": "gaa1zoeng2-parent-example-1",
    "id": "gaa1zoeng2-parent-example-1",
    "text": "學校安排左家長會。"
  },
  {
    "filename": "gaa1zoeng2-parent-example-2",
    "id": "gaa1zoeng2-parent-example-2",
    "text": "家長應該支持孩子嘅學習。"
  },
  {
    "filename": "gaa1zoeng2-parent-example-3",
    "id": "gaa1zoeng2-parent-example-3",
    "text": "家長帶仔女去醫生度檢查。"
  },
  {
    "filename": "gaa1zoeng2-parent-example-4",
    "id": "gaa1zoeng2-parent-example-4",
    "text": "呢個表格要家長簽名。"
  },
  {
    "filename": "gaa1zuk6-family-clan",
    "id": "gaa1zuk6-family-clan",
    "text": "家族"
  },
  {
    "filename": "gaa1zuk6-family-clan-example-1",
    "id": "gaa1zuk6-family-clan-example-1",
    "text": "我嘅家族好大，有好多親戚。"
  },
  {
    "filename": "gaa1zuk6-family-clan-example-2",
    "id": "gaa1zuk6-family-clan-example-2",
    "text": "佢哋家族傳統好重視禮儀。"
  },
  {
    "filename": "gaa1zuk6-family-clan-example-3",
    "id": "gaa1zuk6-family-clan-example-3",
    "text": "家族聚會每年都會辦一次。"
  },
  {
    "filename": "gaa1zuk6-family-clan-example-4",
    "id": "gaa1zuk6-family-clan-example-4",
    "text": "佢係呢個家族嘅重要成員。"
  },
  {
    "filename": "gaa1zung1-at-home",
    "id": "gaa1zung1-at-home",
    "text": "家中"
  },
  {
    "filename": "gaa1zung1-at-home-example-1",
    "id": "gaa1zung1-at-home-example-1",
    "text": "我家中而家冇人。"
  },
  {
    "filename": "gaa1zung1-at-home-example-2",
    "id": "gaa1zung1-at-home-example-2",
    "text": "你家中有冇寵物？"
  },
  {
    "filename": "gaa1zung1-at-home-example-3",
    "id": "gaa1zung1-at-home-example-3",
    "text": "家中嘅氣氛好溫馨。"
  },
  {
    "filename": "gaa1zung1-at-home-example-4",
    "id": "gaa1zung1-at-home-example-4",
    "text": "我想留喺家中休息。"
  },
  {
    "filename": "gai3fu6-stepfather",
    "id": "gai3fu6-stepfather",
    "text": "繼父"
  },
  {
    "filename": "gai3fu6-stepfather-example-1",
    "id": "gai3fu6-stepfather-example-1",
    "text": "我嘅繼父好好人。"
  },
  {
    "filename": "gai3fu6-stepfather-example-2",
    "id": "gai3fu6-stepfather-example-2",
    "text": "你繼父做咩工？"
  },
  {
    "filename": "gai3fu6-stepfather-example-3",
    "id": "gai3fu6-stepfather-example-3",
    "text": "佢同佢嘅繼父相處得好好。"
  },
  {
    "filename": "gai3fu6-stepfather-example-4",
    "id": "gai3fu6-stepfather-example-4",
    "text": "我細個開始接受我嘅繼父。"
  },
  {
    "filename": "gai3mou5-stepmother",
    "id": "gai3mou5-stepmother",
    "text": "繼母"
  },
  {
    "filename": "gai3mou5-stepmother-example-1",
    "id": "gai3mou5-stepmother-example-1",
    "text": "我嘅繼母好好人。"
  },
  {
    "filename": "gai3mou5-stepmother-example-2",
    "id": "gai3mou5-stepmother-example-2",
    "text": "你想唔想介紹你嘅繼母畀我認識？"
  },
  {
    "filename": "gai3mou5-stepmother-example-3",
    "id": "gai3mou5-stepmother-example-3",
    "text": "繼母同我哋嘅關係唔係好親。"
  },
  {
    "filename": "gai3mou5-stepmother-example-4",
    "id": "gai3mou5-stepmother-example-4",
    "text": "繼母黎咗我哋屋企做咗幾年。"
  },
  {
    "filename": "go1go1-older-brother",
    "id": "go1go1-older-brother",
    "text": "哥哥"
  },
  {
    "filename": "go1go1-older-brother-example-1",
    "id": "go1go1-older-brother-example-1",
    "text": "我有一個哥哥。"
  },
  {
    "filename": "go1go1-older-brother-example-2",
    "id": "go1go1-older-brother-example-2",
    "text": "哥哥今日返學未？"
  },
  {
    "filename": "go1go1-older-brother-example-3",
    "id": "go1go1-older-brother-example-3",
    "text": "我哋細個時，哥哥教我打波。"
  },
  {
    "filename": "go1go1-older-brother-example-4",
    "id": "go1go1-older-brother-example-4",
    "text": "哥哥，幫我攞下嗰個喇。"
  },
  {
    "filename": "gu1gu1-aunt-fathers-sister",
    "id": "gu1gu1-aunt-fathers-sister",
    "text": "姑姑"
  },
  {
    "filename": "gu1gu1-aunt-fathers-sister-example-1",
    "id": "gu1gu1-aunt-fathers-sister-example-1",
    "text": "我今日去見姑姑。"
  },
  {
    "filename": "gu1gu1-aunt-fathers-sister-example-2",
    "id": "gu1gu1-aunt-fathers-sister-example-2",
    "text": "姑姑煮咗好好味嘅晚餐。"
  },
  {
    "filename": "gu1gu1-aunt-fathers-sister-example-3",
    "id": "gu1gu1-aunt-fathers-sister-example-3",
    "text": "我細個時候，姑姑經常陪我玩。"
  },
  {
    "filename": "gu1gu1-aunt-fathers-sister-example-4",
    "id": "gu1gu1-aunt-fathers-sister-example-4",
    "text": "姑姑屋企喺香港中心區。"
  },
  {
    "filename": "gu1maa1-aunt",
    "id": "gu1maa1-aunt",
    "text": "姑媽"
  },
  {
    "filename": "gu1maa1-aunt-example-1",
    "id": "gu1maa1-aunt-example-1",
    "text": "我哋今晚去姑媽屋企食飯。"
  },
  {
    "filename": "gu1maa1-aunt-example-2",
    "id": "gu1maa1-aunt-example-2",
    "text": "姑媽送咗我一份禮物。"
  },
  {
    "filename": "gu1maa1-aunt-example-3",
    "id": "gu1maa1-aunt-example-3",
    "text": "我嘅姑媽住喺九龍。"
  },
  {
    "filename": "gu1maa1-aunt-example-4",
    "id": "gu1maa1-aunt-example-4",
    "text": "姑媽成日教我煮嘢食。"
  },
  {
    "filename": "gung1gung1-grandfather-paternal",
    "id": "gung1gung1-grandfather-paternal",
    "text": "公公"
  },
  {
    "filename": "gung1gung1-grandfather-paternal-example-1",
    "id": "gung1gung1-grandfather-paternal-example-1",
    "text": "我嘅公公好鍾意種花。"
  },
  {
    "filename": "gung1gung1-grandfather-paternal-example-2",
    "id": "gung1gung1-grandfather-paternal-example-2",
    "text": "今次公公嚟我哋屋企食飯。"
  },
  {
    "filename": "gung1gung1-grandfather-paternal-example-3",
    "id": "gung1gung1-grandfather-paternal-example-3",
    "text": "公公教我識用筷子。"
  },
  {
    "filename": "gung1gung1-grandfather-paternal-example-4",
    "id": "gung1gung1-grandfather-paternal-example-4",
    "text": "我想買禮物畀公公。"
  },
  {
    "filename": "hing1dai6-brothers",
    "id": "hing1dai6-brothers",
    "text": "兄弟"
  },
  {
    "filename": "hing1dai6-brothers-example-1",
    "id": "hing1dai6-brothers-example-1",
    "text": "我有兩個兄弟。"
  },
  {
    "filename": "hing1dai6-brothers-example-2",
    "id": "hing1dai6-brothers-example-2",
    "text": "佢係我嘅兄弟。"
  },
  {
    "filename": "hing1dai6-brothers-example-3",
    "id": "hing1dai6-brothers-example-3",
    "text": "我同兄弟一齊去打波。"
  },
  {
    "filename": "hing1dai6-brothers-example-4",
    "id": "hing1dai6-brothers-example-4",
    "text": "兄弟之間要互相幫忙。"
  },
  {
    "filename": "hing1dai6zi2mui6-siblings",
    "id": "hing1dai6zi2mui6-siblings",
    "text": "兄弟姊妹"
  },
  {
    "filename": "hing1dai6zi2mui6-siblings-example-1",
    "id": "hing1dai6zi2mui6-siblings-example-1",
    "text": "我有三個兄弟姊妹。"
  },
  {
    "filename": "hing1dai6zi2mui6-siblings-example-2",
    "id": "hing1dai6zi2mui6-siblings-example-2",
    "text": "兄弟姊妹之間應該支持對方。"
  },
  {
    "filename": "hing1dai6zi2mui6-siblings-example-3",
    "id": "hing1dai6zi2mui6-siblings-example-3",
    "text": "佢啲兄弟姊妹住喺香港。"
  },
  {
    "filename": "hing1dai6zi2mui6-siblings-example-4",
    "id": "hing1dai6zi2mui6-siblings-example-4",
    "text": "兄弟姊妹一齊去旅行。"
  },
  {
    "filename": "jat1gaa1zi1zyu2-head-of-family",
    "id": "jat1gaa1zi1zyu2-head-of-family",
    "text": "一家之主"
  },
  {
    "filename": "jat1gaa1zi1zyu2-head-of-family-example-1",
    "id": "jat1gaa1zi1zyu2-head-of-family-example-1",
    "text": "佢係我哋屋企嘅一家之主。"
  },
  {
    "filename": "jat1gaa1zi1zyu2-head-of-family-example-2",
    "id": "jat1gaa1zi1zyu2-head-of-family-example-2",
    "text": "做一家之主要負好多責任。"
  },
  {
    "filename": "jat1gaa1zi1zyu2-head-of-family-example-3",
    "id": "jat1gaa1zi1zyu2-head-of-family-example-3",
    "text": "老人家通常係一家之主。"
  },
  {
    "filename": "jat1gaa1zi1zyu2-head-of-family-example-4",
    "id": "jat1gaa1zi1zyu2-head-of-family-example-4",
    "text": "你唔可以隨便挑戰一家之主嘅決定。"
  },
  {
    "filename": "je4je4-grandfather-paternal",
    "id": "je4je4-grandfather-paternal",
    "text": "爺爺"
  },
  {
    "filename": "je4je4-grandfather-paternal-example-1",
    "id": "je4je4-grandfather-paternal-example-1",
    "text": "我個爺爺鐘意種花。"
  },
  {
    "filename": "je4je4-grandfather-paternal-example-2",
    "id": "je4je4-grandfather-paternal-example-2",
    "text": "你有冇見過你嘅爺爺？"
  },
  {
    "filename": "je4je4-grandfather-paternal-example-3",
    "id": "je4je4-grandfather-paternal-example-3",
    "text": "我哋星期日去探爺爺。"
  },
  {
    "filename": "je4je4-grandfather-paternal-example-4",
    "id": "je4je4-grandfather-paternal-example-4",
    "text": "爺爺教我點樣整湯。"
  },
  {
    "filename": "ji4maa4-aunt-mothers-sister",
    "id": "ji4maa4-aunt-mothers-sister",
    "text": "姨媽"
  },
  {
    "filename": "ji4maa4-aunt-mothers-sister-example-1",
    "id": "ji4maa4-aunt-mothers-sister-example-1",
    "text": "我姨媽今日嚟探我。"
  },
  {
    "filename": "ji4maa4-aunt-mothers-sister-example-2",
    "id": "ji4maa4-aunt-mothers-sister-example-2",
    "text": "你姨媽好叻下廚。"
  },
  {
    "filename": "ji4maa4-aunt-mothers-sister-example-3",
    "id": "ji4maa4-aunt-mothers-sister-example-3",
    "text": "我常常同姨媽一齊去行街。"
  },
  {
    "filename": "ji4maa4-aunt-mothers-sister-example-4",
    "id": "ji4maa4-aunt-mothers-sister-example-4",
    "text": "姨媽送咗我一份禮物。"
  },
  {
    "filename": "ji4mui6-aunt-younger",
    "id": "ji4mui6-aunt-younger",
    "text": "姨妹"
  },
  {
    "filename": "ji4mui6-aunt-younger-example-1",
    "id": "ji4mui6-aunt-younger-example-1",
    "text": "我姨妹今次嚟香港旅行。"
  },
  {
    "filename": "ji4mui6-aunt-younger-example-2",
    "id": "ji4mui6-aunt-younger-example-2",
    "text": "你識唔識我姨妹？"
  },
  {
    "filename": "ji4mui6-aunt-younger-example-3",
    "id": "ji4mui6-aunt-younger-example-3",
    "text": "姨妹仔好鍾意食甜品。"
  },
  {
    "filename": "ji4mui6-aunt-younger-example-4",
    "id": "ji4mui6-aunt-younger-example-4",
    "text": "姨妹幫我買咗啲禮物。"
  },
  {
    "filename": "kau5fu6-maternal-uncle",
    "id": "kau5fu6-maternal-uncle",
    "text": "舅父"
  },
  {
    "filename": "kau5fu6-maternal-uncle-example-1",
    "id": "kau5fu6-maternal-uncle-example-1",
    "text": "我舅父今晚會嚟我屋企。"
  },
  {
    "filename": "kau5fu6-maternal-uncle-example-2",
    "id": "kau5fu6-maternal-uncle-example-2",
    "text": "舅父幫我哋搬咗啲嘢。"
  },
  {
    "filename": "kau5fu6-maternal-uncle-example-3",
    "id": "kau5fu6-maternal-uncle-example-3",
    "text": "我細個時經常同舅父玩。"
  },
  {
    "filename": "kau5fu6-maternal-uncle-example-4",
    "id": "kau5fu6-maternal-uncle-example-4",
    "text": "舅父喺我家庭入面好重要。"
  },
  {
    "filename": "maa1maa1-mother",
    "id": "maa1maa1-mother",
    "text": "媽媽"
  },
  {
    "filename": "maa1maa1-mother-example-1",
    "id": "maa1maa1-mother-example-1",
    "text": "媽媽喺屋企煮晚飯。"
  },
  {
    "filename": "maa1maa1-mother-example-2",
    "id": "maa1maa1-mother-example-2",
    "text": "你媽媽好唔好？"
  },
  {
    "filename": "maa1maa1-mother-example-3",
    "id": "maa1maa1-mother-example-3",
    "text": "我媽媽叫我快啲返屋企。"
  },
  {
    "filename": "maa1maa1-mother-example-4",
    "id": "maa1maa1-mother-example-4",
    "text": "媽媽帶我去買餸。"
  },
  {
    "filename": "maa4maa4-grandmother-paternal",
    "id": "maa4maa4-grandmother-paternal",
    "text": "嫲嫲"
  },
  {
    "filename": "maa4maa4-grandmother-paternal-example-1",
    "id": "maa4maa4-grandmother-paternal-example-1",
    "text": "我今日去拜嫲嫲。"
  },
  {
    "filename": "maa4maa4-grandmother-paternal-example-2",
    "id": "maa4maa4-grandmother-paternal-example-2",
    "text": "嫲嫲煮咗好多好味嘅餸。"
  },
  {
    "filename": "maa4maa4-grandmother-paternal-example-3",
    "id": "maa4maa4-grandmother-paternal-example-3",
    "text": "你㗎嫲嫲住喺邊？"
  },
  {
    "filename": "maa4maa4-grandmother-paternal-example-4",
    "id": "maa4maa4-grandmother-paternal-example-4",
    "text": "嫲嫲好鍾意同我哋講故仔。"
  },
  {
    "filename": "mou5can1-mother-formal",
    "id": "mou5can1-mother-formal",
    "text": "母親"
  },
  {
    "filename": "mou5can1-mother-formal-example-1",
    "id": "mou5can1-mother-formal-example-1",
    "text": "我嘅母親今日生日。"
  },
  {
    "filename": "mou5can1-mother-formal-example-2",
    "id": "mou5can1-mother-formal-example-2",
    "text": "你母親叫咩名？"
  },
  {
    "filename": "mou5can1-mother-formal-example-3",
    "id": "mou5can1-mother-formal-example-3",
    "text": "母親幫我整飯。"
  },
  {
    "filename": "mou5can1-mother-formal-example-4",
    "id": "mou5can1-mother-formal-example-4",
    "text": "我尊重我嘅母親。"
  },
  {
    "filename": "mui6mui6-younger-sister",
    "id": "mui6mui6-younger-sister",
    "text": "妹妹"
  },
  {
    "filename": "mui6mui6-younger-sister-example-1",
    "id": "mui6mui6-younger-sister-example-1",
    "text": "我有一個妹妹。"
  },
  {
    "filename": "mui6mui6-younger-sister-example-2",
    "id": "mui6mui6-younger-sister-example-2",
    "text": "妹妹今日去學校。"
  },
  {
    "filename": "mui6mui6-younger-sister-example-3",
    "id": "mui6mui6-younger-sister-example-3",
    "text": "你嘅妹妹幾多歲？"
  },
  {
    "filename": "mui6mui6-younger-sister-example-4",
    "id": "mui6mui6-younger-sister-example-4",
    "text": "妹妹鍾意唱歌。"
  },
  {
    "filename": "naam4zai2-boy",
    "id": "naam4zai2-boy",
    "text": "男仔"
  },
  {
    "filename": "naam4zai2-boy-example-1",
    "id": "naam4zai2-boy-example-1",
    "text": "嗰個男仔好聰明。"
  },
  {
    "filename": "naam4zai2-boy-example-2",
    "id": "naam4zai2-boy-example-2",
    "text": "你有冇細個男仔？"
  },
  {
    "filename": "naam4zai2-boy-example-3",
    "id": "naam4zai2-boy-example-3",
    "text": "我見到啲男仔喺公園玩。"
  },
  {
    "filename": "naam4zai2-boy-example-4",
    "id": "naam4zai2-boy-example-4",
    "text": "你想買本書俾男仔睇嗎？"
  },
  {
    "filename": "neoi5-daughter",
    "id": "neoi5-daughter",
    "text": "女"
  },
  {
    "filename": "neoi5-daughter-example-1",
    "id": "neoi5-daughter-example-1",
    "text": "我有一個女。"
  },
  {
    "filename": "neoi5-daughter-example-2",
    "id": "neoi5-daughter-example-2",
    "text": "佢係男定女？"
  },
  {
    "filename": "neoi5-daughter-example-3",
    "id": "neoi5-daughter-example-3",
    "text": "你嘅女幾歲？"
  },
  {
    "filename": "neoi5-daughter-example-4",
    "id": "neoi5-daughter-example-4",
    "text": "呢隻貓係女嘅。"
  },
  {
    "filename": "neoi5sai3-son-in-law",
    "id": "neoi5sai3-son-in-law",
    "text": "女婿"
  },
  {
    "filename": "neoi5sai3-son-in-law-example-1",
    "id": "neoi5sai3-son-in-law-example-1",
    "text": "我女婿好負責任。"
  },
  {
    "filename": "neoi5sai3-son-in-law-example-2",
    "id": "neoi5sai3-son-in-law-example-2",
    "text": "你幾時介紹你女婿畀我認識？"
  },
  {
    "filename": "neoi5sai3-son-in-law-example-3",
    "id": "neoi5sai3-son-in-law-example-3",
    "text": "我哋同女婿相處得好開心。"
  },
  {
    "filename": "neoi5sai3-son-in-law-example-4",
    "id": "neoi5sai3-son-in-law-example-4",
    "text": "女婿係家庭重要一員。"
  },
  {
    "filename": "neoi5zai2-girl",
    "id": "neoi5zai2-girl",
    "text": "女仔"
  },
  {
    "filename": "neoi5zai2-girl-example-1",
    "id": "neoi5zai2-girl-example-1",
    "text": "我有一個女仔。"
  },
  {
    "filename": "neoi5zai2-girl-example-2",
    "id": "neoi5zai2-girl-example-2",
    "text": "嗰個女仔好叻。"
  },
  {
    "filename": "neoi5zai2-girl-example-3",
    "id": "neoi5zai2-girl-example-3",
    "text": "你女仔識唔識游水？"
  },
  {
    "filename": "neoi5zai2-girl-example-4",
    "id": "neoi5zai2-girl-example-4",
    "text": "我鐘意同女仔傾計。"
  },
  {
    "filename": "ngo5go3neoi5-my-daughter",
    "id": "ngo5go3neoi5-my-daughter",
    "text": "我個女"
  },
  {
    "filename": "ngo5go3neoi5-my-daughter-example-1",
    "id": "ngo5go3neoi5-my-daughter-example-1",
    "text": "我個女今日唔返學。"
  },
  {
    "filename": "ngo5go3neoi5-my-daughter-example-2",
    "id": "ngo5go3neoi5-my-daughter-example-2",
    "text": "你個女幾歲呀？"
  },
  {
    "filename": "ngo5go3neoi5-my-daughter-example-3",
    "id": "ngo5go3neoi5-my-daughter-example-3",
    "text": "我個女鍾意唱歌。"
  },
  {
    "filename": "ngo5go3neoi5-my-daughter-example-4",
    "id": "ngo5go3neoi5-my-daughter-example-4",
    "text": "我個女啱啱學識行路。"
  },
  {
    "filename": "ngo5go3zai2-my-son",
    "id": "ngo5go3zai2-my-son",
    "text": "我個仔"
  },
  {
    "filename": "ngo5go3zai2-my-son-example-1",
    "id": "ngo5go3zai2-my-son-example-1",
    "text": "我個仔今日返學。"
  },
  {
    "filename": "ngo5go3zai2-my-son-example-2",
    "id": "ngo5go3zai2-my-son-example-2",
    "text": "我個仔鍾意食雪糕。"
  },
  {
    "filename": "ngo5go3zai2-my-son-example-3",
    "id": "ngo5go3zai2-my-son-example-3",
    "text": "我個仔玩咗好耐電腦遊戲。"
  },
  {
    "filename": "ngo5go3zai2-my-son-example-4",
    "id": "ngo5go3zai2-my-son-example-4",
    "text": "我個仔而家唔係屋企。"
  },
  {
    "filename": "ngoi6gung1-grandfather-maternal",
    "id": "ngoi6gung1-grandfather-maternal",
    "text": "外公"
  },
  {
    "filename": "ngoi6gung1-grandfather-maternal-example-1",
    "id": "ngoi6gung1-grandfather-maternal-example-1",
    "text": "我星期日去見外公。"
  },
  {
    "filename": "ngoi6gung1-grandfather-maternal-example-2",
    "id": "ngoi6gung1-grandfather-maternal-example-2",
    "text": "外公煮嘢食好好味。"
  },
  {
    "filename": "ngoi6gung1-grandfather-maternal-example-3",
    "id": "ngoi6gung1-grandfather-maternal-example-3",
    "text": "細路好鍾意同外公玩。"
  },
  {
    "filename": "ngoi6gung1-grandfather-maternal-example-4",
    "id": "ngoi6gung1-grandfather-maternal-example-4",
    "text": "我外公住喺新界。"
  },
  {
    "filename": "ngoi6po4-grandmother-maternal",
    "id": "ngoi6po4-grandmother-maternal",
    "text": "外婆"
  },
  {
    "filename": "ngoi6po4-grandmother-maternal-example-1",
    "id": "ngoi6po4-grandmother-maternal-example-1",
    "text": "我成日去探外婆。"
  },
  {
    "filename": "ngoi6po4-grandmother-maternal-example-2",
    "id": "ngoi6po4-grandmother-maternal-example-2",
    "text": "外婆整嘅飯好好味。"
  },
  {
    "filename": "ngoi6po4-grandmother-maternal-example-3",
    "id": "ngoi6po4-grandmother-maternal-example-3",
    "text": "你嘅外婆幾多歲？"
  },
  {
    "filename": "ngoi6po4-grandmother-maternal-example-4",
    "id": "ngoi6po4-grandmother-maternal-example-4",
    "text": "細路仔鍾意聽外婆講故仔。"
  },
  {
    "filename": "ngok6fu6-father-in-law",
    "id": "ngok6fu6-father-in-law",
    "text": "岳父"
  },
  {
    "filename": "ngok6fu6-father-in-law-example-1",
    "id": "ngok6fu6-father-in-law-example-1",
    "text": "我今日要同岳父食飯。"
  },
  {
    "filename": "ngok6fu6-father-in-law-example-2",
    "id": "ngok6fu6-father-in-law-example-2",
    "text": "岳父好錫我。"
  },
  {
    "filename": "ngok6fu6-father-in-law-example-3",
    "id": "ngok6fu6-father-in-law-example-3",
    "text": "你岳父係邊個？"
  },
  {
    "filename": "ngok6fu6-father-in-law-example-4",
    "id": "ngok6fu6-father-in-law-example-4",
    "text": "岳父送咗張禮物俾我。"
  },
  {
    "filename": "ngok6mou5-mother-in-law",
    "id": "ngok6mou5-mother-in-law",
    "text": "岳母"
  },
  {
    "filename": "ngok6mou5-mother-in-law-example-1",
    "id": "ngok6mou5-mother-in-law-example-1",
    "text": "我星期日去見我岳母。"
  },
  {
    "filename": "ngok6mou5-mother-in-law-example-2",
    "id": "ngok6mou5-mother-in-law-example-2",
    "text": "我岳母好鐘意煮飯。"
  },
  {
    "filename": "ngok6mou5-mother-in-law-example-3",
    "id": "ngok6mou5-mother-in-law-example-3",
    "text": "你同你岳母相處得好唔好？"
  },
  {
    "filename": "ngok6mou5-mother-in-law-example-4",
    "id": "ngok6mou5-mother-in-law-example-4",
    "text": "我仔同我岳母送咗花。"
  },
  {
    "filename": "po4po4-grandmother-paternal",
    "id": "po4po4-grandmother-paternal",
    "text": "婆婆"
  },
  {
    "filename": "po4po4-grandmother-paternal-example-1",
    "id": "po4po4-grandmother-paternal-example-1",
    "text": "我今晚去探婆婆。"
  },
  {
    "filename": "po4po4-grandmother-paternal-example-2",
    "id": "po4po4-grandmother-paternal-example-2",
    "text": "婆婆煮嘢食好好味。"
  },
  {
    "filename": "po4po4-grandmother-paternal-example-3",
    "id": "po4po4-grandmother-paternal-example-3",
    "text": "你識唔識我阿婆婆？"
  },
  {
    "filename": "po4po4-grandmother-paternal-example-4",
    "id": "po4po4-grandmother-paternal-example-4",
    "text": "婆婆教我點樣織毛衣。"
  },
  {
    "filename": "sai3lou2-younger-brother",
    "id": "sai3lou2-younger-brother",
    "text": "細佬"
  },
  {
    "filename": "sai3lou2-younger-brother-example-1",
    "id": "sai3lou2-younger-brother-example-1",
    "text": "我細佬今日返學遲咗。"
  },
  {
    "filename": "sai3lou2-younger-brother-example-2",
    "id": "sai3lou2-younger-brother-example-2",
    "text": "你細佬係幾多歲？"
  },
  {
    "filename": "sai3lou2-younger-brother-example-3",
    "id": "sai3lou2-younger-brother-example-3",
    "text": "細佬，快啲嚟食飯！"
  },
  {
    "filename": "sai3lou2-younger-brother-example-4",
    "id": "sai3lou2-younger-brother-example-4",
    "text": "我成日同細佬一齊玩。"
  },
  {
    "filename": "sai3lou6-youngest-child",
    "id": "sai3lou6-youngest-child",
    "text": "細路"
  },
  {
    "filename": "sai3lou6-youngest-child-example-1",
    "id": "sai3lou6-youngest-child-example-1",
    "text": "我有兩個細路。"
  },
  {
    "filename": "sai3lou6-youngest-child-example-2",
    "id": "sai3lou6-youngest-child-example-2",
    "text": "細路喺度玩緊球。"
  },
  {
    "filename": "sai3lou6-youngest-child-example-3",
    "id": "sai3lou6-youngest-child-example-3",
    "text": "細路夜晚唔岩瞓覺。"
  },
  {
    "filename": "sai3lou6-youngest-child-example-4",
    "id": "sai3lou6-youngest-child-example-4",
    "text": "細路食完飯要洗手。"
  },
  {
    "filename": "sai3mui6-younger-sister",
    "id": "sai3mui6-younger-sister",
    "text": "細妹"
  },
  {
    "filename": "sai3mui6-younger-sister-example-1",
    "id": "sai3mui6-younger-sister-example-1",
    "text": "我有一個細妹。"
  },
  {
    "filename": "sai3mui6-younger-sister-example-2",
    "id": "sai3mui6-younger-sister-example-2",
    "text": "你細妹幾多歲呀？"
  },
  {
    "filename": "sai3mui6-younger-sister-example-3",
    "id": "sai3mui6-younger-sister-example-3",
    "text": "細妹今日唔返學。"
  },
  {
    "filename": "sai3mui6-younger-sister-example-4",
    "id": "sai3mui6-younger-sister-example-4",
    "text": "我細妹鍾意唱歌。"
  },
  {
    "filename": "sai3neoi5-youngest-daughter",
    "id": "sai3neoi5-youngest-daughter",
    "text": "細女"
  },
  {
    "filename": "sai3neoi5-youngest-daughter-example-1",
    "id": "sai3neoi5-youngest-daughter-example-1",
    "text": "我嘅細女今年十歲。"
  },
  {
    "filename": "sai3neoi5-youngest-daughter-example-2",
    "id": "sai3neoi5-youngest-daughter-example-2",
    "text": "你有冇細女？"
  },
  {
    "filename": "sai3neoi5-youngest-daughter-example-3",
    "id": "sai3neoi5-youngest-daughter-example-3",
    "text": "細女鍾意畫畫。"
  },
  {
    "filename": "sai3neoi5-youngest-daughter-example-4",
    "id": "sai3neoi5-youngest-daughter-example-4",
    "text": "細女同哥哥好親。"
  },
  {
    "filename": "sai3zi2-youngest-son",
    "id": "sai3zi2-youngest-son",
    "text": "細仔"
  },
  {
    "filename": "sai3zi2-youngest-son-example-1",
    "id": "sai3zi2-youngest-son-example-1",
    "text": "我嘅細仔好鍾意踢波。"
  },
  {
    "filename": "sai3zi2-youngest-son-example-2",
    "id": "sai3zi2-youngest-son-example-2",
    "text": "你細仔幾歲呀？"
  },
  {
    "filename": "sai3zi2-youngest-son-example-3",
    "id": "sai3zi2-youngest-son-example-3",
    "text": "細仔今朝自己食早餐。"
  },
  {
    "filename": "sai3zi2-youngest-son-example-4",
    "id": "sai3zi2-youngest-son-example-4",
    "text": "佢係家裏嘅細仔。"
  },
  {
    "filename": "san1pou4-daughter-in-law",
    "id": "san1pou4-daughter-in-law",
    "text": "新抱"
  },
  {
    "filename": "san1pou4-daughter-in-law-example-1",
    "id": "san1pou4-daughter-in-law-example-1",
    "text": "我個新抱好勤力。"
  },
  {
    "filename": "san1pou4-daughter-in-law-example-2",
    "id": "san1pou4-daughter-in-law-example-2",
    "text": "新抱今日未返嚟。"
  },
  {
    "filename": "san1pou4-daughter-in-law-example-3",
    "id": "san1pou4-daughter-in-law-example-3",
    "text": "新抱煮咗一餐好好味嘅飯。"
  },
  {
    "filename": "san1pou4-daughter-in-law-example-4",
    "id": "san1pou4-daughter-in-law-example-4",
    "text": "你同我新抱相處得好好。"
  },
  {
    "filename": "suk1suk1-uncle-fathers-younger",
    "id": "suk1suk1-uncle-fathers-younger",
    "text": "叔叔"
  },
  {
    "filename": "suk1suk1-uncle-fathers-younger-example-1",
    "id": "suk1suk1-uncle-fathers-younger-example-1",
    "text": "我個叔叔好細心。"
  },
  {
    "filename": "suk1suk1-uncle-fathers-younger-example-2",
    "id": "suk1suk1-uncle-fathers-younger-example-2",
    "text": "嗰位叔叔係我爸爸嘅弟弟。"
  },
  {
    "filename": "suk1suk1-uncle-fathers-younger-example-3",
    "id": "suk1suk1-uncle-fathers-younger-example-3",
    "text": "我細個時，叔叔成日帶我去公園玩。"
  },
  {
    "filename": "suk1suk1-uncle-fathers-younger-example-4",
    "id": "suk1suk1-uncle-fathers-younger-example-4",
    "text": "早晨，叔叔，你食咗未？"
  },
  {
    "filename": "syun1-grandchild",
    "id": "syun1-grandchild",
    "text": "孫"
  },
  {
    "filename": "syun1-grandchild-example-1",
    "id": "syun1-grandchild-example-1",
    "text": "我有兩個孫。"
  },
  {
    "filename": "syun1-grandchild-example-2",
    "id": "syun1-grandchild-example-2",
    "text": "你嘅孫仔幾歲？"
  },
  {
    "filename": "syun1-grandchild-example-3",
    "id": "syun1-grandchild-example-3",
    "text": "我奶奶好鍾意孫女。"
  },
  {
    "filename": "syun1-grandchild-example-4",
    "id": "syun1-grandchild-example-4",
    "text": "孫輩都嚟咗拜年。"
  },
  {
    "filename": "syun1neoi5-granddaughter",
    "id": "syun1neoi5-granddaughter",
    "text": "孫女"
  },
  {
    "filename": "syun1neoi5-granddaughter-example-1",
    "id": "syun1neoi5-granddaughter-example-1",
    "text": "我嘅孫女今日去學校。"
  },
  {
    "filename": "syun1neoi5-granddaughter-example-2",
    "id": "syun1neoi5-granddaughter-example-2",
    "text": "你有孫女定孫仔？"
  },
  {
    "filename": "syun1neoi5-granddaughter-example-3",
    "id": "syun1neoi5-granddaughter-example-3",
    "text": "阿婆好鍾意同孫女玩。"
  },
  {
    "filename": "syun1neoi5-granddaughter-example-4",
    "id": "syun1neoi5-granddaughter-example-4",
    "text": "我要買禮物畀我嘅孫女。"
  },
  {
    "filename": "syun1zai2-grandson",
    "id": "syun1zai2-grandson",
    "text": "孫仔"
  },
  {
    "filename": "syun1zai2-grandson-example-1",
    "id": "syun1zai2-grandson-example-1",
    "text": "我嘅孫仔好叻，識得講三種語言。"
  },
  {
    "filename": "syun1zai2-grandson-example-2",
    "id": "syun1zai2-grandson-example-2",
    "text": "阿婆今日帶孫仔去公園玩。"
  },
  {
    "filename": "syun1zai2-grandson-example-3",
    "id": "syun1zai2-grandson-example-3",
    "text": "你個孫仔幾時返嚟探我？"
  },
  {
    "filename": "syun1zai2-grandson-example-4",
    "id": "syun1zai2-grandson-example-4",
    "text": "孫仔同我一齊食晚飯。"
  },
  {
    "filename": "tong4dai6-cousin-younger-male-paternal",
    "id": "tong4dai6-cousin-younger-male-paternal",
    "text": "堂弟"
  },
  {
    "filename": "tong4dai6-cousin-younger-male-paternal-example-1",
    "id": "tong4dai6-cousin-younger-male-paternal-example-1",
    "text": "我個堂弟上星期結婚喇。"
  },
  {
    "filename": "tong4dai6-cousin-younger-male-paternal-example-2",
    "id": "tong4dai6-cousin-younger-male-paternal-example-2",
    "text": "堂弟今日唔返學，因為佢病咗。"
  },
  {
    "filename": "tong4dai6-cousin-younger-male-paternal-example-3",
    "id": "tong4dai6-cousin-younger-male-paternal-example-3",
    "text": "我同堂弟一齊去睇戲。"
  },
  {
    "filename": "tong4dai6-cousin-younger-male-paternal-example-4",
    "id": "tong4dai6-cousin-younger-male-paternal-example-4",
    "text": "堂弟好叻，考咗第一名。"
  },
  {
    "filename": "tong4go1-cousin-older-male-paternal",
    "id": "tong4go1-cousin-older-male-paternal",
    "text": "堂哥"
  },
  {
    "filename": "tong4go1-cousin-older-male-paternal-example-1",
    "id": "tong4go1-cousin-older-male-paternal-example-1",
    "text": "我同堂哥一齊去行街。"
  },
  {
    "filename": "tong4go1-cousin-older-male-paternal-example-2",
    "id": "tong4go1-cousin-older-male-paternal-example-2",
    "text": "堂哥教我點樣煮魚。"
  },
  {
    "filename": "tong4go1-cousin-older-male-paternal-example-3",
    "id": "tong4go1-cousin-older-male-paternal-example-3",
    "text": "你個堂哥喺邊度返工？"
  },
  {
    "filename": "tong4go1-cousin-older-male-paternal-example-4",
    "id": "tong4go1-cousin-older-male-paternal-example-4",
    "text": "堂哥細個嗰陣我哋經常一齊玩。"
  },
  {
    "filename": "tong4mui6-cousin-younger-female-paternal",
    "id": "tong4mui6-cousin-younger-female-paternal",
    "text": "堂妹"
  },
  {
    "filename": "tong4mui6-cousin-younger-female-paternal-example-1",
    "id": "tong4mui6-cousin-younger-female-paternal-example-1",
    "text": "我堂妹今日嚟屋企玩。"
  },
  {
    "filename": "tong4mui6-cousin-younger-female-paternal-example-2",
    "id": "tong4mui6-cousin-younger-female-paternal-example-2",
    "text": "堂妹識唔識踢足球？"
  },
  {
    "filename": "tong4mui6-cousin-younger-female-paternal-example-3",
    "id": "tong4mui6-cousin-younger-female-paternal-example-3",
    "text": "我堂妹同我差兩年。"
  },
  {
    "filename": "tong4mui6-cousin-younger-female-paternal-example-4",
    "id": "tong4mui6-cousin-younger-female-paternal-example-4",
    "text": "你堂妹幾時返嚟？"
  },
  {
    "filename": "tong4ze2-cousin-older-female-paternal",
    "id": "tong4ze2-cousin-older-female-paternal",
    "text": "堂姐"
  },
  {
    "filename": "tong4ze2-cousin-older-female-paternal-example-1",
    "id": "tong4ze2-cousin-older-female-paternal-example-1",
    "text": "我堂姐喺度等我。"
  },
  {
    "filename": "tong4ze2-cousin-older-female-paternal-example-2",
    "id": "tong4ze2-cousin-older-female-paternal-example-2",
    "text": "明日我同堂姐一齊去買嘢。"
  },
  {
    "filename": "tong4ze2-cousin-older-female-paternal-example-3",
    "id": "tong4ze2-cousin-older-female-paternal-example-3",
    "text": "你認識我堂姊未？"
  },
  {
    "filename": "tong4ze2-cousin-older-female-paternal-example-4",
    "id": "tong4ze2-cousin-older-female-paternal-example-4",
    "text": "我堂姐好叻，佢啱啱攞咗獎。"
  },
  {
    "filename": "uk1kei2-home",
    "id": "uk1kei2-home",
    "text": "屋企"
  },
  {
    "filename": "uk1kei2-home-example-1",
    "id": "uk1kei2-home-example-1",
    "text": "我今晚唔返屋企。"
  },
  {
    "filename": "uk1kei2-home-example-2",
    "id": "uk1kei2-home-example-2",
    "text": "你屋企有幾多人？"
  },
  {
    "filename": "uk1kei2-home-example-3",
    "id": "uk1kei2-home-example-3",
    "text": "屋企嘅阿媽今朝煮咗早餐。"
  },
  {
    "filename": "uk1kei2-home-example-4",
    "id": "uk1kei2-home-example-4",
    "text": "我想好好照顧屋企人。"
  },
  {
    "filename": "uk1kei2jan4-family",
    "id": "uk1kei2jan4-family",
    "text": "屋企人"
  },
  {
    "filename": "uk1kei2jan4-family-example-1",
    "id": "uk1kei2jan4-family-example-1",
    "text": "我今晚同屋企人去食飯。"
  },
  {
    "filename": "uk1kei2jan4-family-example-2",
    "id": "uk1kei2jan4-family-example-2",
    "text": "屋企人都好支持我。"
  },
  {
    "filename": "uk1kei2jan4-family-example-3",
    "id": "uk1kei2jan4-family-example-3",
    "text": "週末我會返屋企見屋企人。"
  },
  {
    "filename": "uk1kei2jan4-family-example-4",
    "id": "uk1kei2jan4-family-example-4",
    "text": "屋企人平時幫我好多。"
  },
  {
    "filename": "zai2-son",
    "id": "zai2-son",
    "text": "仔"
  },
  {
    "filename": "zai2-son-example-1",
    "id": "zai2-son-example-1",
    "text": "我有一個仔。"
  },
