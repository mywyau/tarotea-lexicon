{
  "id": "mou5-not-have",
  "word": "冇",
  "jyutping": "mou5",
  "meaning": "to not have; there is not",

  "pos": ["verb"],

  "usage": [
    "Used as the negation of 有 to indicate lack or non-existence",
    "Commonly used to say that something is not present or unavailable",
    "Replaces 沒有 in spoken Cantonese"
  ],

  "examples": [
    {
      "id": "mou5-not-have-example-1",
      "sentence": "我冇時間。",
      "jyutping": "ngo5 mou5 si4 gaan3",
      "meaning": "I don’t have time."
    },
    {
      "id": "mou5-not-have-example-2",
      "sentence": "呢度冇人。",
      "jyutping": "ni1 dou6 mou5 jan4",
      "meaning": "There is no one here."
    }
  ],

