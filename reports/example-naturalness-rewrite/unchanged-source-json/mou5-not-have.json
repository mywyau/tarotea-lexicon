{
  "id": "mou5-not-have",
  "word": "冇",
  "jyutping": "mou5",
  "meaning": "not have; there is no / there are no",
  "pos": ["verb"],
  "usage": [
    "Used as the negation of 有 to mean \"not have\".",
    "Also used to say that something does not exist or is not present.",
    "冇 is the normal spoken Cantonese form, while 沒有 is more Mandarin or formal written style."
  ],
  "examples": [
    {
      "id": "mou5-not-have-example-1",
      "sentence": "我冇時間。",
      "jyutping": "ngo5 mou5 si4 gaan3.",
      "meaning": "I don't have time."
    },
    {
      "id": "mou5-not-have-example-2",
      "sentence": "呢度冇人。",
      "jyutping": "ni1 dou6 mou5 jan4.",
      "meaning": "There is no one here."
    },
    {
      "id": "mou5-not-have-example-3",
      "sentence": "我今日冇堂。",
      "jyutping": "ngo5 gam1 jat6 mou5 tong4.",
      "meaning": "I don't have class today."
    },
    {
      "id": "mou5-not-have-example-4",
      "sentence": "雪櫃入面冇嘢食。",
      "jyutping": "syut3 gwai6 jap6 min6 mou5 je5 sik6.",
      "meaning": "There is nothing to eat in the fridge."
    }
  ],
